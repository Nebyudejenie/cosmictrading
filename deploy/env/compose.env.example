# Compose variables for the systemd unit → /srv/cosmic/config/compose.env
COSMIC_IMAGE_TAG=<git-short-sha>
COMPOSE_PROFILES=
# COMPOSE_PROFILES=tunnel            after the tunnel token exists (docs/12 §5)
# COMPOSE_PROFILES=tunnel,telegram   after a Telegram bot token exists
COSMIC_SECRETS_DIR=/srv/cosmic/secrets
COSMIC_CONFIG_DIR=/srv/cosmic/config
COSMIC_BACKUP_DIR=/srv/cosmic/backups
COSMIC_ENV_FILE=/srv/cosmic/config/cosmic.env
