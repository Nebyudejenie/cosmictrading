# Production configuration (non-secret) → /srv/cosmic/config/cosmic.env (0640 root:10001).
# Secrets are NOT set here: they are files in /srv/cosmic/secrets mounted by compose.prod.yaml.
# This file is included in encrypted backups, so it must never contain a secret.
COSMIC_ENV=PAPER_TRADING
COSMIC_DB_NAME=cosmic
# The public portal hostname (placeholder until the owner names it, B-03) and 127.0.0.1
# for the container healthcheck.
COSMIC_ALLOWED_HOSTS=["<portal-host>.<zone>","127.0.0.1"]
COSMIC_COOKIE_SECURE=true
COSMIC_DEBUG=false
COSMIC_LOG_LEVEL=INFO
COSMIC_LOG_JSON=true
COSMIC_MAX_AUTHORITY_MODE=PAPER_TRADING
# COSMIC_LIVE_VENUES=[]  (ADR-034 lock 3: real-money venues; only the owner sets it)
COSMIC_AI_POLICY=FREE_CLOUD_AI_ONLY
COSMIC_TELEGRAM_APPROVAL_REQUIRES_TOTP=true
COSMIC_PAPER_FAULT_INJECTION=false
COSMIC_MARKET_DATA_ENABLED=true
# Venues no longer used (ADR-027): not polled, not tradable, stored data kept. Retire a venue
# only after its positions are closed. Example: ["COINBASE","BITSTAMP"]
COSMIC_RETIRED_VENUES=[]
COSMIC_DISK_WARNING_FREE_PCT=15
COSMIC_DISK_CRITICAL_FREE_PCT=10
