# Jump host only: authenticate with a key, then forward to the host's sshd. Nothing else.
Port 2222
HostKey /etc/ssh/keys/ssh_host_ed25519_key
PidFile /run/sshd.pid
AuthorizedKeysFile /etc/ssh/authorized/%u
StrictModes yes

PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
AllowUsers jump
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 10:30:60

# Only "ssh -J" / ProxyJump to the host's sshd.
AllowTcpForwarding local
PermitOpen host.docker.internal:22
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitTTY no
PermitUserRC no
ForceCommand /bin/echo "cosmictrading jump host: use ssh -J; no shell here"

ClientAliveInterval 60
ClientAliveCountMax 3
LogLevel VERBOSE
