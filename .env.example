# COSMICTRADING QUANT configuration reference. Copy values into .env (local) or into
# secret files referenced by *_FILE variables (production). Placeholders only.

# Environment tier: LOCAL_DEVELOPMENT | TEST | PAPER_TRADING | STAGING | LIVE_DISABLED
# (LIVE and LIVE_PENDING_APPROVAL are refused: no live broker adapter exists.)
COSMIC_ENV=LOCAL_DEVELOPMENT

# Database (passwords may instead be given as COSMIC_DB_*_PASSWORD_FILE=/run/secrets/...)
COSMIC_DB_HOST=127.0.0.1
COSMIC_DB_PORT=55442
COSMIC_DB_NAME=cosmic
COSMIC_DB_APP_USER=cosmic_app
COSMIC_DB_APP_PASSWORD=<random>
COSMIC_DB_OWNER_USER=cosmic_owner
COSMIC_DB_OWNER_PASSWORD=<random>
COSMIC_DB_SUPERUSER_PASSWORD=<random; only needed for bootstrap>

# Application secret: base64 of exactly 32 random bytes (MFA secret encryption).
COSMIC_SECRET_KEY=<base64-32-bytes>
# Bearer token for /internal/metrics (never routed publicly).
COSMIC_METRICS_TOKEN=<random>

# Web
COSMIC_WEB_HOST=127.0.0.1
COSMIC_WEB_PORT=8742
COSMIC_ALLOWED_HOSTS=["127.0.0.1","localhost"]
# Must be true outside LOCAL_DEVELOPMENT/TEST (served over HTTPS via Cloudflare).
COSMIC_COOKIE_SECURE=true
COSMIC_DEBUG=false
COSMIC_LOG_LEVEL=INFO
COSMIC_LOG_JSON=true

# Authority cap: the stored mode can never exceed this (PAPER_TRADING by default).
COSMIC_MAX_AUTHORITY_MODE=PAPER_TRADING

# Free cloud AI only. Keys are optional; without them AI is NOT_CONFIGURED.
COSMIC_AI_POLICY=FREE_CLOUD_AI_ONLY
COSMIC_GROQ_API_KEY=
COSMIC_GEMINI_API_KEY=
COSMIC_OPENROUTER_API_KEY=

# Telegram (optional). Without a token the bot stays disabled; the portal remains complete.
COSMIC_TELEGRAM_BOT_TOKEN=
COSMIC_TELEGRAM_APPROVAL_REQUIRES_TOTP=true

# Paper broker fault injection: LOCAL_DEVELOPMENT/TEST only.
COSMIC_PAPER_FAULT_INJECTION=false

# Market data polling (keyless public endpoints)
COSMIC_MARKET_DATA_ENABLED=true

# Resource thresholds
COSMIC_DATA_PATH=/
COSMIC_DISK_WARNING_FREE_PCT=15
COSMIC_DISK_CRITICAL_FREE_PCT=10
